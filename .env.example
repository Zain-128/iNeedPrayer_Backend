PORT=3004
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d
# Optional: access vs refresh (social login returns both). Defaults match JWT_EXPIRES_IN / 7d.
# JWT_ACCESS_EXPIRES_IN=7d
# JWT_REFRESH_EXPIRES_IN=7d
# JWT_REFRESH_SECRET=your-refresh-secret-or-same-as-JWT_SECRET

# Fixed reset code, only accepted while SMTP below is NOT configured (dev). Default 1234.
# PASSWORD_RESET_CODE=1234

# Ops secret for POST /api/admin/auth/promote and POST /api/admin/auth/create
# Required header: x-admin-secret: <value>
# ADMIN_PROMOTE_SECRET=change-me-to-a-long-random-string

# Optional: restrict browser CORS (comma-separated). Omit for * (typical for React Native + JWT).
# ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Church verify screen stub — 5-digit OTP in app (default 12345).
# CHURCH_VERIFY_CODE=12345

# Realtime chat + live stream: Socket.IO uses the same PORT as HTTP. Connect with
# socket.io-client and pass JWT: auth: { token: "<same as REST Bearer>" }.

# --- Agora live streaming (RTC tokens generated server-side) ---
# AGORA_APP_ID=your_agora_app_id
# AGORA_APP_CERTIFICATE=your_agora_app_certificate
# AGORA_TOKEN_EXPIRY_SECONDS=3600
# LIVE_HOST_HEARTBEAT_TIMEOUT_MS=90000

# Absolute public API origin (no trailing slash). Used to rewrite /uploads media URLs in responses.
# Example Hostinger: https://dimgrey-mink-558336.hostingersite.com
# Example Render: https://ineedprayer-backend-1.onrender.com
# PUBLIC_BASE_URL=https://ineedprayer-backend-1.onrender.com

# --- Backblaze B2 image uploads (S3-compatible). If all are set, uploads go to B2; else local ./uploads ---
# IMPORTANT on Hostinger/Render: local ./uploads is wiped on redeploy. Prefer B2 in production.
# B2_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004
# B2_KEY_ID=your_application_key_id
# B2_APPLICATION_KEY=your_application_key_secret
# B2_BUCKET=your-bucket-name
# B2_PUBLIC_URL_BASE=https://f005.backblazeb2.com/file/your-bucket-name

# --- Google Cloud Translation (on-demand "See Translation" for posts/comments) ---
# Enable "Cloud Translation API" in Google Cloud. Falls back to GOOGLE_PLACES_API_KEY if unset.
# GOOGLE_TRANSLATE_API_KEY=
# Languages users may translate into / pick in the app (default: en,es)
# TRANSLATION_SUPPORTED_LANGUAGES=en,es
# Optional: pre-translate every post into these languages at create time (costs more; default: none)
# TRANSLATION_TARGET_LANGUAGES=your_google_cloud_api_key
# --- Google Places API (New) for Church Finder ---
# Enable "Places API (New)" in Google Cloud Console and create an API Key.
# GOOGLE_PLACES_API_KEY=your_google_places_api_key

# --- SMTP email (password reset OTP, church verification, receipts, campaigns) ---
# When SMTP_HOST, SMTP_USER and SMTP_PASS are set, real emails are sent and the fixed
# PASSWORD_RESET_CODE / CHURCH_VERIFY_CODE stubs stop working.
# Hostinger email: smtp.hostinger.com, port 465 | Gmail: smtp.gmail.com, 465 (App Password)
# Brevo: smtp-relay.brevo.com, 587 | SES: email-smtp.<region>.amazonaws.com, 465
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true            # true for 465, false for 587 (defaults from port)
# SMTP_USER=no-reply@yourdomain.com
# SMTP_PASS=your_mailbox_password
# MAIL_FROM_EMAIL=no-reply@yourdomain.com   # defaults to SMTP_USER
# MAIL_FROM_NAME=iNeedPrayer
# SUPPORT_EMAIL=support@yourdomain.com      # shown in footers + used as Reply-To
# EMAIL_LOGO_URL=https://cdn.yourdomain.com/email-logo.png   # optional, ~40px tall PNG
